---
import Base from '../layouts/Base.astro';
---

<Base title="Thanks — Shailendra" description="Your message has been sent.">
  <section class="mx-auto max-w-5xl px-4 py-24 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">Thanks for your message</h1>
    <p class="mt-4 text-lg text-muted">I'll get back to you soon.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center rounded-md bg-accent px-5 py-3 font-medium text-accent-fg hover:opacity-90"
    >Back to home</a>
  </section>
</Base>
