---
import Base from '../layouts/Base.astro';
---

<Base title="Thanks — Shailendra" description="Your message has been sent." noindex>
  <section class="ink min-h-[70vh]"><div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-10">
    <h1 class="display text-[clamp(3rem,9vw,6rem)] text-fg">Thanks for your message</h1>
    <p class="mt-4 text-lg text-muted">I'll get back to you soon.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center rounded-full bg-accent px-7 py-3.5 font-semibold text-accent-fg"
    >Back to home</a>
  </div></section>
</Base>
