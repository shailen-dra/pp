---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Shailendra" description="This page does not exist." noindex>
  <section class="ink min-h-[70vh]">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-10">
      <p class="display outline-text text-[clamp(6rem,22vw,16rem)]" aria-hidden="true">404</p>
      <h1 class="display mt-4 text-[clamp(2.5rem,7vw,5rem)] text-fg">Page not found</h1>
      <p class="mt-4 max-w-[44ch] text-lg text-muted">The link may be old or mistyped. Everything lives on the home page.</p>
      <a href="/" class="mt-8 inline-flex items-center rounded-full bg-accent px-7 py-3.5 font-semibold text-accent-fg">Back to home</a>
    </div>
  </section>
</Base>
