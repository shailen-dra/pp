---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="ink border-t border-border">
  <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-4 px-4 py-8 text-muted sm:flex-row sm:items-center sm:px-6 lg:px-10">
    <p>&copy; {year} {profile.name}. Hand-built and hand-coded.</p>
    <a href="#top" class="font-semibold text-fg underline decoration-transparent underline-offset-4 hover:decoration-accent">Back to top</a>
  </div>
</footer>
