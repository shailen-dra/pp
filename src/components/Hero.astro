---
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
---

<section data-testid="hero" aria-labelledby="hero-heading" class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
  <div class="grid items-center gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-14">
    <Image
      src={profile.photo}
      alt={`Portrait of ${profile.name}`}
      width={800}
      height={800}
      loading="eager"
      fetchpriority="high"
      class="mx-auto aspect-square w-56 rounded-2xl border border-border object-cover sm:w-64 md:w-full"
    />

    <div>
      <h1 id="hero-heading" class="text-4xl font-bold tracking-tight text-fg sm:text-5xl">{profile.name}</h1>

      <ul data-testid="hero-roles" class="mt-5 space-y-2 text-base text-muted sm:text-lg">
        {
          profile.roles.map((role) => (
            <li class="flex items-center gap-3">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {role}
            </li>
          ))
        }
      </ul>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-fg">{profile.headline}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#contact"
          data-testid="cta-contact"
          class="inline-flex items-center rounded-md bg-accent px-5 py-3 font-medium text-accent-fg transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >Get in touch</a>
        <a
          href={profile.cvUrl}
          download
          data-testid="cta-cv"
          class="inline-flex items-center rounded-md border border-border px-5 py-3 font-medium text-fg transition-colors hover:bg-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >Download CV</a>
      </div>
    </div>
  </div>
</section>
