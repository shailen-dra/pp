---
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#journey', label: 'Journey' },
  { href: '#contact', label: 'Contact', cta: true },
];

const initials = profile.name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<header id="top" data-testid="site-header" class="ink sticky top-0 z-40 border-b border-border">
  <div class="mx-auto flex h-[4.25rem] max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-10">
    <a href="#top" class="flex min-w-0 items-center gap-3 text-fg">
      <span
        class="grid h-9 w-9 shrink-0 place-items-center rounded-md border border-accent text-sm font-extrabold text-accent [font-stretch:75%]"
        aria-hidden="true">{initials}</span>
      <span class="truncate text-lg font-extrabold tracking-wide uppercase [font-stretch:75%]">{profile.name}</span>
    </a>

    <div class="flex items-center gap-1">
      <nav aria-label="Main" data-testid="desktop-nav" class="hidden items-center gap-1 md:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              data-variant={link.cta ? 'cta' : undefined}
              class={
                link.cta
                  ? 'ml-3 rounded-full border border-accent px-5 py-2 font-semibold text-accent transition-colors hover:bg-accent hover:text-accent-fg'
                  : 'rounded-full px-3.5 py-2 font-medium text-fg/85 transition-colors hover:text-fg'
              }
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />

      <button
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-fg hover:bg-white/10 md:hidden"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="border-t border-border md:hidden">
    <ul class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-variant={link.cta ? 'cta' : undefined}
              class={
                link.cta
                  ? 'mt-2 block rounded-full bg-accent px-4 py-3 text-center font-semibold text-accent-fg'
                  : 'block rounded-lg px-3 py-3 text-2xl font-extrabold uppercase [font-stretch:75%] text-fg hover:bg-white/5'
              }
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('button[aria-controls="mobile-menu"]');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    button.addEventListener('click', () => setOpen(!menu.classList.contains('is-open')));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
