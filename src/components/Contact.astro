---
import { contact } from '../data/profile';
import { mailtoHref, telHref, whatsappHref } from '../lib/contact';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || 'TBC_WEB3FORMS_KEY';
const redirect = new URL('/thanks', Astro.site).toString();

const channels = [
  { label: 'Phone', value: contact.phone, href: telHref(contact.phone) },
  { label: 'WhatsApp', value: contact.phone, href: whatsappHref(contact.phone), external: true },
  { label: 'Email', value: contact.email, href: mailtoHref(contact.email) },
  { label: 'LinkedIn', value: 'LinkedIn profile', href: contact.linkedin, external: true },
  { label: 'GitHub', value: 'GitHub profile', href: contact.github, external: true },
];

const field =
  'mt-1.5 block w-full rounded-md border border-border bg-bg px-3 py-2.5 text-fg placeholder:text-muted focus:border-accent focus:outline-2 focus:outline-accent';
---

<section id="contact" aria-labelledby="contact-heading" class="border-t border-border">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
    <p class="text-sm font-semibold tracking-wider text-accent uppercase">Contact</p>
    <h2 id="contact-heading" class="mt-2 text-3xl font-bold tracking-tight text-fg sm:text-4xl">Get in touch</h2>

    <div class="mt-10 grid gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
      <div>
        <p class="text-lg text-muted">Have a question or a project in mind? Send a message or reach me directly.</p>
        <ul class="mt-6 space-y-4">
          {
            channels.map((channel) => (
              <li>
                <span class="block text-sm text-muted">{channel.label}</span>
                <a
                  href={channel.href}
                  class="font-medium break-words text-fg underline decoration-border underline-offset-4 hover:decoration-accent"
                  {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {channel.value}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <form
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="space-y-5 rounded-xl border border-border bg-card p-6"
      >
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="redirect" value={redirect} />
        <input type="hidden" name="subject" value="New message from portfolio" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div>
          <label for="contact-name" class="text-sm font-medium text-fg">Name</label>
          <input id="contact-name" name="name" type="text" required autocomplete="name" class={field} />
        </div>
        <div>
          <label for="contact-email" class="text-sm font-medium text-fg">Email</label>
          <input id="contact-email" name="email" type="email" required autocomplete="email" class={field} />
        </div>
        <div>
          <label for="contact-phone" class="text-sm font-medium text-fg">Phone <span class="text-muted">(optional)</span></label>
          <input id="contact-phone" name="phone" type="tel" autocomplete="tel" class={field} />
        </div>
        <div>
          <label for="contact-message" class="text-sm font-medium text-fg">Message</label>
          <textarea id="contact-message" name="message" rows="5" required class={field}></textarea>
        </div>

        <button
          type="submit"
          class="inline-flex w-full items-center justify-center rounded-md bg-accent px-5 py-3 font-medium text-accent-fg transition-opacity hover:opacity-90 disabled:cursor-wait disabled:opacity-70 sm:w-auto"
        >Send message</button>

        <p
          data-testid="form-status"
          role="status"
          aria-live="polite"
          class="text-sm font-medium data-[state=error]:text-red-700 data-[state=success]:text-accent dark:data-[state=error]:text-red-400"
        ></p>
      </form>
    </div>
  </div>
</section>

<script>
  import { initContactForm } from '../scripts/contact-form';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) initContactForm(form);
</script>
