---
import { contact } from '../data/profile';
import { mailtoHref, telHref, whatsappHref } from '../lib/contact';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || 'TBC_WEB3FORMS_KEY';
const formReady = !accessKey.startsWith('TBC_');
const redirect = new URL('/thanks', Astro.site).toString();

const channels = [
  { label: 'Phone', value: contact.phone, href: telHref(contact.phone) },
  { label: 'WhatsApp', value: contact.phone, href: whatsappHref(contact.phone), external: true },
  { label: 'Email', value: contact.email, href: mailtoHref(contact.email) },
  { label: 'LinkedIn', value: 'LinkedIn profile', href: contact.linkedin, external: true },
  { label: 'GitHub', value: 'GitHub profile', href: contact.github, external: true },
];

const label = 'text-sm font-semibold text-fg';
const field =
  'mt-2 block w-full rounded-xl border border-border bg-field px-4 py-3 text-fg focus:border-accent focus:outline-2 focus:outline-offset-0 focus:outline-accent';
---

<section id="contact" aria-labelledby="contact-heading" class="ink stack z-40">
  <div class="mx-auto grid max-w-7xl gap-14 px-4 py-24 sm:px-6 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-16 md:py-32 lg:px-10">
    <div>
      <h2 id="contact-heading" data-reveal class="display text-[clamp(3.5rem,9vw,7rem)]">Get in touch</h2>
      <p class="mt-6 max-w-[36ch] text-xl leading-relaxed text-muted">
        Have a question or a project in mind? Send a message and I'll get back to you.
      </p>

      <ul class="mt-10 border-b border-border">
        {
          channels.map((channel) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-border py-4">
              <span class="text-muted">{channel.label}</span>
              <a
                href={channel.href}
                class="font-semibold break-all text-fg underline decoration-transparent underline-offset-4 transition-colors hover:decoration-accent"
                {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {channel.value}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      class="self-start rounded-3xl border border-border bg-card p-6 sm:p-10"
    >
      {
        !formReady && (
          <noscript>
            <p data-testid="form-nojs-notice" class="mb-6 rounded-xl border border-border p-4 text-sm text-fg">
              The form is not connected yet. Please email me at{' '}
              <a href={mailtoHref(contact.email)} class="font-semibold underline underline-offset-4">{contact.email}</a>.
            </p>
          </noscript>
        )
      }
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="redirect" value={redirect} />
      <input type="hidden" name="subject" value="New message from portfolio" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="contact-name" class={label}>Name</label>
          <input id="contact-name" name="name" type="text" required autocomplete="name" class={field} />
        </div>
        <div>
          <label for="contact-email" class={label}>Email</label>
          <input id="contact-email" name="email" type="email" required autocomplete="email" class={field} />
        </div>
      </div>
      <div class="mt-5">
        <label for="contact-phone" class={label}>Phone <span class="font-normal text-muted">(optional)</span></label>
        <input id="contact-phone" name="phone" type="tel" autocomplete="tel" class={field} />
      </div>
      <div class="mt-5">
        <label for="contact-message" class={label}>Message</label>
        <textarea id="contact-message" name="message" rows="6" required class={field}></textarea>
      </div>

      <button
        type="submit"
        class="mt-7 inline-flex w-full items-center justify-center rounded-full bg-accent px-8 py-3.5 font-semibold text-accent-fg transition-transform hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-70 sm:w-auto"
      >Send message</button>

      <p
        data-testid="form-status"
        role="status"
        aria-live="polite"
        class="mt-4 text-sm font-semibold empty:mt-0 data-[state=error]:text-red-400 data-[state=success]:text-accent"
      ></p>
    </form>
  </div>
</section>

<script>
  import { initContactForm } from '../scripts/contact-form';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) initContactForm(form);
</script>
