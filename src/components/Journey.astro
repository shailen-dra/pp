---
import { journey } from '../data/profile';
---

<section id="journey" aria-labelledby="journey-heading" class="paper stack z-30">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-32 lg:px-10">
    <h2 id="journey-heading" data-reveal class="display text-[clamp(3rem,7vw,5.5rem)]">Where I've worked</h2>

    <ol data-reveal="stagger" class="mt-14 grid gap-12 md:grid-cols-3 md:gap-8">
      {
        journey.map((entry, index) => (
          <li data-testid="journey-item" class="relative border-t-2 border-fg pt-6">
            <span class="draw-line absolute inset-x-0 -top-0.5 h-0.5 bg-accent" aria-hidden="true" />
            <span
              class="badge-pop absolute -top-[0.95rem] left-0 z-10 rounded-full bg-accent px-3 py-0.5 text-sm font-bold text-accent-fg tabular-nums"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
              <span class="display text-xl tabular-nums">{entry.period}</span>
              <span data-testid="journey-tag" class="rounded-full border border-fg/40 px-2.5 py-px text-xs font-semibold text-fg">{entry.tag}</span>
            </div>
            <h3 class="mt-4 text-xl font-bold text-fg">{entry.title}</h3>
            <p class="font-medium text-fg">{entry.org}</p>
            <p class="mt-3 text-muted">{entry.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
