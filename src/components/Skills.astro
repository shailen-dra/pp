---
import { experienceLabel, skillGroups } from '../data/profile';
---

<section id="skills" aria-labelledby="skills-heading" class="ink stack z-20">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-32 lg:px-10">
    <h2 id="skills-heading" data-reveal class="display text-[clamp(3rem,8.5vw,7rem)]">
      <span class="block">{experienceLabel}.</span>
      <span class="block text-accent">Shopify &amp; WordPress.</span>
      <span class="block">Built to convert.</span>
    </h2>

    <p class="mt-10 max-w-[60ch] text-lg leading-relaxed text-muted">
      I take a design and turn it into clean, responsive markup that holds up in every browser, then connect it to
      the platform the store already runs on and tune it so more visitors buy.
    </p>

    <ul class="mt-16 grid gap-px border-y border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((group) => (
          <li data-testid="skill-card" class="bg-bg py-7 sm:px-7">
            <h3 class="display text-2xl text-accent md:text-[1.7rem]">{group.title}</h3>
            <p class="mt-2 text-muted">{group.items.join(', ')}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
